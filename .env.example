# Skopiuj ten plik jako .env i uzupełnij wartościami.
# .env jest w .gitignore — prawdziwe sekrety nigdy nie trafiają do repozytorium.
#
# Podział poniżej nie jest kosmetyczny, bo decyduje o sposobie wdrożenia:
#
#   * NEXT_PUBLIC_*  — wklejane w bundle w czasie `next build`. Wartość jest
#                      zamrożona w zbudowanym pliku JS, więc jej zmiana wymaga
#                      przebudowania i ponownego wdrożenia. Trafiają do
#                      przeglądarki, więc nie wolno tu umieszczać sekretów.
#
#   * pozostałe      — czytane w runtime z procesu serwera. Zmiana wartości
#                      wymaga jedynie restartu/wdrożenia, nie przebudowania.
#                      Nigdy nie nadawaj im prefiksu NEXT_PUBLIC_.

# ---------- widoczne w przeglądarce (wklejane przy buildzie) ----------

# Adres projektu Supabase, np. https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publiczny klucz Supabase (publishable). Bezpieczny w przeglądarce, chroni go RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Klucz witryny Cloudflare Turnstile (publiczny).
# Lokalnie użyj testowego klucza "zawsze przechodzi": 1x00000000000000000000AA
# Na produkcji klucz prawdziwy, a domena musi być dodana do Hostname Management
# widgetu — inaczej widget się nie wyrenderuje (błąd 110200).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Opcjonalne. Bazowy adres aplikacji, używany jako fallback przy budowaniu
# linków w mailach z Supabase. Bez tego brany jest nagłówek żądania.
NEXT_PUBLIC_SITE_URL=

# ---------- tylko serwer (czytane w runtime) ----------

# Klucz API OpenRoutera (https://openrouter.ai/keys).
OPEN_ROUTER_API_KEY=

# Sekretny klucz Supabase. Omija RLS, więc daje pełny dostęp do danych —
# trzymaj go wyłącznie po stronie serwera i tylko gdy jest naprawdę potrzebny.
SUPABASE_SECRET_KEY=

# Połączenie z Postgresem dla Supabase CLI (npm run db:push).
# Prowadzone przez pooler IPv4: bezpośredni db.<ref>.supabase.co ma wyłącznie
# rekord AAAA i nie jest osiągalny z tego komputera.
SUPABASE_DB_URL=

# Sekret Cloudflare Turnstile — weryfikacja tokenu po stronie serwera.
# Lokalnie testowy sekret "zawsze przechodzi": 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=


# ---------- jak Next ładuje pliki .env ----------
#
# Kolejność ładowania, plik późniejszy wygrywa nad wcześniejszym:
#
#   1. .env
#   2. .env.<NODE_ENV>          np. .env.production, .env.development
#   3. .env.local               (pomijany w testach)
#   4. .env.<NODE_ENV>.local    np. .env.production.local
#
# Zmienne rzeczywistego środowiska procesu mają priorytet nad wszystkimi tymi
# plikami — dlatego na hoście wartości z panelu po prostu wygrywają.
#
# Wdrożenie, dwa przypadki i żadnego ręcznego przełączania:
#
#   * Build na hoście (Vercel itd.) — .env nie jest tam wysyłany, bo jest
#     w .gitignore. Build czyta zmienne ustawione w panelu hosta. Nie edytujesz
#     i nie przywracasz niczego.
#
#   * Lokalny build produkcyjny — załóż raz .env.production.local z
#     produkcyjnymi wartościami. Nadpisze .env przy `next build`, a `next dev`
#     (NODE_ENV=development) nadal korzysta z .env. Oba tryby działają równolegle.
#
# Na koniec: NEXT_PUBLIC_* są wklejane w bundle w czasie builda, więc zmiana
# takiej wartości wymaga ponownego builda. Sekrety server-only wystarczy
# podmienić i zrestartować proces.
